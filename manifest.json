{
  "manifest_version": 3,
  "name": "YouTube Watch Later Quick Actions",
  "description": "Adds one-click copy link and remove buttons to YouTube Watch Later.",
  "version": "1.0.7",
  "minimum_chrome_version": "114",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
