{
  "manifest_version": 3,
  "name": "YouTube Watch Later Quick Actions",
  "description": "Watch Later quick actions (copy link, remove) and one-click transcript download on watch pages.",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js",
        "transcript.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
